<?xml version="1.0" encoding="UTF-8"?>
<!-- XSD là contract của SOAP service. Spring dùng file này để sinh /ws/transfers.wsdl. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://example.com/learning/transfer"
           xmlns:tns="http://example.com/learning/transfer"
           elementFormDefault="qualified">

    <!-- SOAP request body: client phải gửi element TransferRequest với các field bên trong. -->
    <xs:element name="TransferRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="requestId" type="xs:string"/>
                <xs:element name="fromAccount" type="xs:string"/>
                <xs:element name="toAccount" type="xs:string"/>
                <xs:element name="amount" type="xs:decimal"/>
                <xs:element name="currency" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- SOAP response body: server sẽ trả về element TransferResponse. -->
    <xs:element name="TransferResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="transactionId" type="xs:string"/>
                <xs:element name="requestId" type="xs:string"/>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="amount" type="xs:decimal"/>
                <xs:element name="fee" type="xs:decimal"/>
                <xs:element name="currency" type="xs:string"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
